    "preview": "tsc -b && vite build --mode cloudflare && wrangler dev",
    "prettier": "prettier --ignore-path .gitignore --write \"./src/**/*.+(js|ts|json)\"",
    "prettier:fix": "npx prettier --write src",
    "deploy": "tsc -b && vite build --mode cloudflare && wrangler deploy",
    "typecheck": "tsc -b"
  },
