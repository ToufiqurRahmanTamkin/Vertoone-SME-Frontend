VITE_NODE_ENV=development

# The backend origin. The /api/v1 suffix is optional — both forms resolve.
VITE_SERVER_URL=http://localhost:5000

# ─── Realtime ─────────────────────────────────────────────────────────────
# Defaults to the VITE_SERVER_URL origin (without the /api/v1 suffix), so this
# only needs setting when the socket server is hosted separately from the API.
# VITE_SOCKET_URL=http://localhost:5000
# VITE_SOCKET_PATH=/socket.io
#
# A serverless backend (Vercel) cannot hold a WebSocket open. Set this to false
# for those deployments — the app then falls back to polling and hides the
# "Live" indicator instead of retrying a connection that can never succeed.
# VITE_SOCKET_ENABLED=true

VITE_APP_NAME=Vertoone SME
VITE_APP_SHORT_NAME=Vertoone
